{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agents-io/v1/OutboundCalloutAnswer",
  "type": "object",
  "required": [
    "verdict"
  ],
  "properties": {
    "verdict": {
      "anyOf": [
        {
          "const": "allow",
          "type": "string"
        },
        {
          "const": "deny",
          "type": "string"
        }
      ]
    }
  }
}
