{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agents-io/v1/AdminConfigPutResult",
  "type": "object",
  "required": [
    "revision",
    "issues",
    "applied"
  ],
  "properties": {
    "revision": {
      "type": "string"
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "message"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "code": {
            "type": "string"
          },
          "severity": {
            "anyOf": [
              {
                "const": "error",
                "type": "string"
              },
              {
                "const": "warning",
                "type": "string"
              }
            ]
          }
        }
      }
    },
    "applied": {
      "anyOf": [
        {
          "const": "live",
          "type": "string"
        },
        {
          "const": "restart",
          "type": "string"
        }
      ]
    },
    "channels": {
      "type": "object",
      "required": [
        "started",
        "stopped"
      ],
      "properties": {
        "started": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "type",
              "account"
            ],
            "properties": {
              "type": {
                "type": "string"
              },
              "account": {
                "type": "string"
              }
            }
          }
        },
        "stopped": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "type",
              "account"
            ],
            "properties": {
              "type": {
                "type": "string"
              },
              "account": {
                "type": "string"
              }
            }
          }
        },
        "failed": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "type",
              "account",
              "error"
            ],
            "properties": {
              "type": {
                "type": "string"
              },
              "account": {
                "type": "string"
              },
              "error": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}
