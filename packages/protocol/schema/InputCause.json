{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agents-io/v1/InputCause",
  "type": "object",
  "required": [
    "peer",
    "basis"
  ],
  "properties": {
    "peer": {
      "type": "string"
    },
    "basis": {
      "anyOf": [
        {
          "const": "internal",
          "type": "string"
        },
        {
          "const": "recovered",
          "type": "string"
        },
        {
          "const": "declared",
          "type": "string"
        },
        {
          "const": "none",
          "type": "string"
        }
      ]
    },
    "hop": {
      "minimum": 1,
      "type": "integer"
    },
    "chain": {
      "type": "string"
    },
    "from": {
      "type": "object",
      "required": [
        "sessionKey",
        "turnId"
      ],
      "properties": {
        "sessionKey": {
          "type": "string"
        },
        "turnId": {
          "type": "string"
        }
      }
    },
    "rootPrincipal": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "carried": {
      "type": "object",
      "required": [
        "external",
        "watched",
        "group"
      ],
      "properties": {
        "external": {
          "type": "boolean"
        },
        "watched": {
          "type": "boolean"
        },
        "group": {
          "type": "boolean"
        }
      }
    }
  }
}
