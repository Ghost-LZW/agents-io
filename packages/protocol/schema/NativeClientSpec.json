{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agents-io/v1/NativeClientSpec",
  "type": "object",
  "required": [
    "command",
    "args"
  ],
  "properties": {
    "command": {
      "minLength": 1,
      "type": "string"
    },
    "args": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "env": {
      "type": "object",
      "patternProperties": {
        "^(.*)$": {
          "type": "string"
        }
      }
    }
  }
}
