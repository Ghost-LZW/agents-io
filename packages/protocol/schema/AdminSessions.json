{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agents-io/v1/AdminSessions",
  "type": "object",
  "required": [
    "sessions"
  ],
  "properties": {
    "sessions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "sessionKey",
          "harness",
          "state",
          "head",
          "queued",
          "pendingRequests",
          "live"
        ],
        "properties": {
          "sessionKey": {
            "type": "string"
          },
          "harness": {
            "type": "string"
          },
          "state": {
            "type": "string"
          },
          "head": {
            "type": "number"
          },
          "turnId": {
            "type": "string"
          },
          "queued": {
            "type": "number"
          },
          "pendingRequests": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "live": {
            "type": "boolean"
          },
          "launch": {
            "type": "object",
            "required": [
              "envKeys"
            ],
            "properties": {
              "cwd": {
                "type": "string"
              },
              "envKeys": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          },
          "attention": {
            "type": "object",
            "required": [
              "state",
              "reasons",
              "since",
              "seq"
            ],
            "properties": {
              "state": {
                "anyOf": [
                  {
                    "const": "needs_you",
                    "type": "string"
                  },
                  {
                    "const": "working",
                    "type": "string"
                  },
                  {
                    "const": "failed",
                    "type": "string"
                  },
                  {
                    "const": "idle",
                    "type": "string"
                  }
                ]
              },
              "reasons": {
                "type": "array",
                "items": {
                  "anyOf": [
                    {
                      "type": "object",
                      "required": [
                        "kind",
                        "requestId",
                        "requestKind",
                        "title",
                        "since"
                      ],
                      "properties": {
                        "kind": {
                          "const": "request",
                          "type": "string"
                        },
                        "requestId": {
                          "type": "string"
                        },
                        "requestKind": {
                          "type": "string"
                        },
                        "title": {
                          "type": "string"
                        },
                        "since": {
                          "type": "number"
                        }
                      }
                    },
                    {
                      "type": "object",
                      "required": [
                        "kind",
                        "turnId",
                        "since"
                      ],
                      "properties": {
                        "kind": {
                          "const": "failed",
                          "type": "string"
                        },
                        "turnId": {
                          "type": "string"
                        },
                        "code": {
                          "type": "string"
                        },
                        "since": {
                          "type": "number"
                        }
                      }
                    },
                    {
                      "type": "object",
                      "required": [
                        "kind",
                        "since"
                      ],
                      "properties": {
                        "kind": {
                          "const": "stalled",
                          "type": "string"
                        },
                        "since": {
                          "type": "number"
                        }
                      }
                    },
                    {
                      "type": "object",
                      "required": [
                        "kind",
                        "inputIds",
                        "since"
                      ],
                      "properties": {
                        "kind": {
                          "const": "queued",
                          "type": "string"
                        },
                        "inputIds": {
                          "type": "array",
                          "items": {
                            "type": "string"
                          }
                        },
                        "since": {
                          "type": "number"
                        }
                      }
                    }
                  ]
                }
              },
              "since": {
                "type": "number"
              },
              "seq": {
                "type": "number"
              },
              "turnId": {
                "type": "string"
              }
            }
          },
          "agent": {
            "type": "string"
          },
          "conversation": {
            "type": "string"
          },
          "topic": {
            "type": "object",
            "required": [
              "id",
              "conversation",
              "sessionKey",
              "state",
              "createdAt",
              "lastActiveAt"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "conversation": {
                "type": "string"
              },
              "sessionKey": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "summary": {
                "type": "string"
              },
              "nativeId": {
                "type": "string"
              },
              "state": {
                "anyOf": [
                  {
                    "const": "current",
                    "type": "string"
                  },
                  {
                    "const": "parked",
                    "type": "string"
                  }
                ]
              },
              "createdAt": {
                "type": "number"
              },
              "lastActiveAt": {
                "type": "number"
              }
            }
          },
          "runId": {
            "type": "string"
          },
          "lastEventAt": {
            "type": "number"
          }
        }
      }
    }
  }
}
