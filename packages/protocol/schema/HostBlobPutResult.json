{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agents-io/v1/HostBlobPutResult",
  "anyOf": [
    {
      "type": "object",
      "required": [
        "ref",
        "size"
      ],
      "properties": {
        "ref": {
          "type": "string"
        },
        "size": {
          "type": "integer"
        }
      }
    },
    {
      "type": "object",
      "required": [
        "upload",
        "received"
      ],
      "properties": {
        "upload": {
          "type": "string"
        },
        "received": {
          "type": "integer"
        }
      }
    }
  ]
}
