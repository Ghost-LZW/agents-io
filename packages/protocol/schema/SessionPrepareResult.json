{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agents-io/v1/SessionPrepareResult",
  "type": "object",
  "required": [
    "sessionKey",
    "agent",
    "launch",
    "created"
  ],
  "properties": {
    "sessionKey": {
      "type": "string"
    },
    "agent": {
      "type": "string"
    },
    "launch": {
      "type": "object",
      "required": [
        "envKeys"
      ],
      "properties": {
        "cwd": {
          "type": "string"
        },
        "envKeys": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "created": {
      "type": "boolean"
    }
  }
}
