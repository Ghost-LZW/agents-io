            {
              "const": "reset",
              "type": "string"
            },
            {
              "const": "resume_interrupted",
              "type": "string"
            }
          ]
        },
        "arg": {
          "type": "string"
        },
        "origin": {
          "type": "object",
          "required": [
            "kind",
            "principal",
            "evidence",
            "via",
            "adapter"
