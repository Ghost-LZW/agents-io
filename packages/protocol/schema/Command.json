                },
                {
                  "const": "dkim_pass",
                  "type": "string"
                },
                {
                  "const": "device_only",
                  "type": "string"
                },
                {
                  "const": "none",
                  "type": "string"
                },
                {
                  "const": "daemon",
                  "type": "string"
