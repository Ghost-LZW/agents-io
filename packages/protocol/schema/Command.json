                            "type": "string"
                          }
                        }
                      }
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "evidence": {
                  "anyOf": [
                    {
                      "const": "platform_signed",
                      "type": "string"
                    },
                    {
                      "const": "dkim_pass",
                      "type": "string"
                    },
                    {
                      "const": "device_only",
                      "type": "string"
                    },
                    {
                      "const": "none",
                      "type": "string"
                    },
                    {
                      "const": "daemon",
                      "type": "string"
                    }
                  ]
                },
                "declared": {
                  "type": "string"
                },
                "self": {
                  "type": "boolean"
                },
                "via": {
                  "type": "string"
                },
                "adapter": {
                  "type": "string"
                }
              }
            },
            "content": {
              "type": "array",
              "items": {
