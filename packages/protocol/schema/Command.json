            "self": {
              "type": "boolean"
            },
            "via": {
              "type": "string"
            },
            "adapter": {
              "type": "string"
            }
          }
        }
      }
    },
    {
      "type": "object",
      "required": [
        "type",
        "sessionKey",
        "requestId",
        "decision",
        "origin"
      ],
      "properties": {
        "type": {
          "const": "resolve",
          "type": "string"
        },
        "sessionKey": {
          "type": "string"
        },
        "requestId": {
          "type": "string"
