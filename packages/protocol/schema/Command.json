    {
      "type": "object",
      "required": [
        "type",
        "sessionKey",
        "input",
        "mode"
      ],
      "properties": {
        "type": {
          "const": "input",
          "type": "string"
        },
        "sessionKey": {
          "type": "string"
        },
        "input": {
