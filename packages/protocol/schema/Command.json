          "properties": {
            "kind": {
              "anyOf": [
                {
                  "const": "human",
                  "type": "string"
                },
                {
                  "const": "agent",
                  "type": "string"
                },
                {
                  "const": "channel_event",
                  "type": "string"
                },
                {
                  "const": "system",
                  "type": "string"
                },
                {
                  "const": "peer",
