                    "type": "object",
                    "required": [
                      "type",
                      "text"
                    ],
                    "properties": {
                      "type": {
                        "const": "text",
                        "type": "string"
                      },
                      "text": {
                        "type": "string"
                      }
                    }
                  },
                  {
                    "type": "object",
                    "required": [
                      "type",
                      "ref",
                      "mime"
                    ],
                    "properties": {
                      "type": {
                        "anyOf": [
                          {
                            "const": "image",
                            "type": "string"
                          },
                          {
                            "const": "file",
                            "type": "string"
                          },
                          {
                            "const": "audio",
                            "type": "string"
                          }
                        ]
                      },
                      "ref": {
                        "type": "string"
                      },
                      "mime": {
                        "type": "string"
                      },
                      "name": {
                        "type": "string"
                      }
                    }
                  },
                  {
                    "type": "object",
                    "required": [
                      "type",
                      "text"
                    ],
                    "properties": {
                      "type": {
                        "const": "quote",
                        "type": "string"
                      },
                      "text": {
                        "type": "string"
                      },
                      "fromMessageId": {
                        "type": "string"
                      },
                      "declared": {
                        "type": "string"
                      }
                    }
                  },
                  {
                    "type": "object",
                    "required": [
                      "type",
                      "text",
                      "startMs",
                      "endMs",
