{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agents-io/v1/ProbeResult",
  "type": "object",
  "required": [
    "version",
    "caps"
  ],
  "properties": {
    "version": {
      "type": "string"
    },
    "caps": {
      "type": "object",
      "required": [
        "steer",
        "interrupt",
        "approvals",
        "questions",
        "tokenDeltas",
        "cancelQueued",
        "injectWithoutTurn",
        "resume",
        "switchModelMidSession",
        "switchProfileMidSession"
      ],
      "properties": {
        "steer": {
          "anyOf": [
            {
              "const": "native",
              "type": "string"
            },
            {
              "const": "tool_boundary",
              "type": "string"
            },
            {
              "const": "none",
              "type": "string"
            }
          ]
        },
        "interrupt": {
          "type": "boolean"
        },
        "approvals": {
          "type": "boolean"
        },
        "questions": {
          "type": "boolean"
        },
        "tokenDeltas": {
          "type": "boolean"
        },
        "cancelQueued": {
          "type": "boolean"
        },
        "injectWithoutTurn": {
          "type": "boolean"
        },
        "resume": {
          "type": "boolean"
        },
        "switchModelMidSession": {
          "type": "boolean"
        },
        "switchProfileMidSession": {
          "type": "boolean"
        },
        "models": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "declares": {
      "type": "object",
      "properties": {
        "displayName": {
          "minLength": 1,
          "type": "string"
        },
        "compact": {
          "type": "object",
          "required": [
            "command"
          ],
          "properties": {
            "command": {
              "minLength": 1,
              "type": "string"
            }
          }
        },
        "modes": {
          "type": "array",
          "items": {
            "const": "plan",
            "type": "string"
          }
        },
        "ownerProfileSwitch": {
          "type": "boolean"
        },
        "ephemeralOpen": {
          "type": "boolean"
        },
        "adopts": {
          "type": "boolean"
        },
        "attach": {
          "anyOf": [
            {
              "const": "join",
              "type": "string"
            },
            {
              "const": "takeover",
              "type": "string"
            }
          ]
        },
        "sessionEnv": {
          "anyOf": [
            {
              "const": "open",
              "type": "string"
            },
            {
              "const": "own-process",
              "type": "string"
            },
            {
              "type": "object",
              "required": [
                "refused"
              ],
              "properties": {
                "refused": {
                  "minLength": 1,
                  "type": "string"
                }
              }
            }
          ]
        }
      }
    },
    "methods": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
