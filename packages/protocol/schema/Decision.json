{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agents-io/v1/Decision",
  "anyOf": [
    {
      "type": "object",
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "const": "allow_once",
          "type": "string"
        }
      }
    },
    {
      "type": "object",
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "const": "allow_session",
          "type": "string"
        },
        "updatedPermissions": {}
      }
    },
    {
      "type": "object",
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "const": "deny",
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "interruptTurn": {
          "type": "boolean"
        }
      }
    },
    {
      "type": "object",
      "required": [
        "kind",
        "answers"
      ],
      "properties": {
        "kind": {
          "const": "answer",
          "type": "string"
        },
        "answers": {
          "type": "object",
          "patternProperties": {
            "^(.*)$": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              ]
            }
          }
        }
      }
    },
    {
      "type": "object",
      "required": [
        "kind",
        "payload"
      ],
      "properties": {
        "kind": {
          "const": "native",
          "type": "string"
        },
        "payload": {}
      }
    }
  ]
}
