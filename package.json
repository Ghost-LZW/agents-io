{
  "name": "agents-io",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.12.0",
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --noEmit false",
    "test": "vitest run --project core --project local",
    "test:core": "vitest run --project core",
    "test:local": "vitest run --project local --passWithNoTests",
    "test:e2e": "vitest run --project e2e --passWithNoTests",
    "test:live": "vitest run --project live --passWithNoTests",
    "invariants:check": "node scripts/invariants.mjs check",
    "invariants:affected": "node scripts/invariants.mjs affected",
    "e2e": "pnpm build && pnpm --filter @agents-io/daemon e2e",
    "schema": "pnpm build && node scripts/emit-schema.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
